# ── Shift Changer — Docker environment template ────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.
#
#   cp .env.example .env
#   # generate a key:  echo "base64:$(openssl rand -base64 32)"
#   docker compose up -d --build
#
# APP_KEY and DB_PASSWORD have no defaults: docker compose refuses to start until both are set.
# This file is the template; the real .env is git-ignored and must never be committed.

# Laravel application key (base64:... string, see above). Required.
APP_KEY=

# Public URL of your VPS / domain (no trailing slash)
APP_URL=http://your-vps-ip-or-domain

# Port the frontend Nginx will be exposed on the host machine
FRONTEND_PORT=80

# Database credentials
DB_DATABASE=shift_changer
DB_USERNAME=postgres
# Required; use a long random value (e.g. `openssl rand -base64 24`).
DB_PASSWORD=

# Sanctum: comma-separated list of stateful domains (your VPS IP or domain)
SANCTUM_STATEFUL_DOMAINS=your-vps-ip-or-domain

# First admin password, needed once by `php artisan db:seed` (admin@shiftchanger.com). Required
# (at least 12 characters) because this stack runs with APP_ENV=production: without it the seeder
# stops and creates nothing. Better passed only to the seed command than kept here:
#   docker compose exec -e SEED_ADMIN_PASSWORD='...' backend php artisan db:seed --force
# SEED_ADMIN_PASSWORD=

# API rate limit: max requests per minute, per user (HTTP 429 beyond that). Default: 60.
# Left commented out on purpose: a value set here also overrides the higher limit (1000) that
# docker-compose.dev.yml uses for local development and the e2e suite.
# API_RATE_LIMIT=60

# Failed logins allowed per minute for one email from one client IP before HTTP 429. Default: 5.
# LOGIN_RATE_LIMIT=5

# Proxies (comma-separated IPs/CIDRs) whose X-Forwarded-For / X-Forwarded-Proto the backend believes.
# Default (empty): the private and loopback ranges, i.e. the frontend Nginx on the compose network.
# Never "*" (anyone could then forge their IP past the rate limits).
# TRUSTED_PROXIES=

# Send the session cookie over HTTPS only. Set to true in production once TLS terminates in front
# of the stack (see README, "HTTPS in production"); keep false for plain http://localhost.
# SESSION_SECURE_COOKIE=true

# The organisation's local timezone: decides what "today" means for business rules (e.g. which
# assignments count as future when a user is deactivated). Default Europe/Warsaw.
# BUSINESS_TIMEZONE=Europe/Warsaw

# ── Hybrid dev only (docker-compose.dev.yml) ───────────────────────────────
# Host port of the backend (bound to 127.0.0.1 only). Default: 8090.
# BACKEND_PORT=8090
# Session cookie domain. Default: localhost.
# SESSION_DOMAIN=localhost
