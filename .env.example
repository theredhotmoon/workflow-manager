# ── Shift Changer — Docker environment template ────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.
#
#   cp .env.example .env
#   # generate a key:  docker compose run --rm backend php artisan key:generate --show
#   docker compose up -d --build

# Laravel application key (base64:... string from `php artisan key:generate`)
APP_KEY=base64:REPLACE_ME

# Public URL of your VPS / domain (no trailing slash)
APP_URL=http://your-vps-ip-or-domain

# Port the frontend Nginx will be exposed on the host machine
FRONTEND_PORT=80

# Database credentials
DB_DATABASE=shift_changer
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production

# Sanctum: comma-separated list of stateful domains (your VPS IP or domain)
SANCTUM_STATEFUL_DOMAINS=your-vps-ip-or-domain
