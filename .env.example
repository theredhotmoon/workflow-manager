# ── Shift Changer — Docker environment template ────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.
#
#   cp .env.example .env
#   # generate a key:  docker compose run --rm backend php artisan key:generate --show
#   docker compose up -d --build

# Laravel application key (base64:... string from `php artisan key:generate`)
APP_KEY=base64:REPLACE_ME

# Public URL of your VPS / domain (no trailing slash)
APP_URL=http://your-vps-ip-or-domain

# Port the frontend Nginx will be exposed on the host machine
FRONTEND_PORT=80

# Database credentials
DB_DATABASE=shift_changer
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production

# Sanctum: comma-separated list of stateful domains (your VPS IP or domain)
SANCTUM_STATEFUL_DOMAINS=your-vps-ip-or-domain

# First admin password, needed once by `php artisan db:seed` (admin@shiftchanger.com). Required
# (at least 12 characters) because this stack runs with APP_ENV=production: without it the seeder
# stops and creates nothing. Better passed only to the seed command than kept here:
#   docker compose exec -e SEED_ADMIN_PASSWORD='...' backend php artisan db:seed --force
# SEED_ADMIN_PASSWORD=

# API rate limit: max requests per minute, per user (HTTP 429 beyond that). Default: 60.
# Left commented out on purpose: a value set here also overrides the higher limit (1000) that
# docker-compose.dev.yml uses for local development and the e2e suite.
# API_RATE_LIMIT=60

# The organisation's local timezone: decides what "today" means for business rules (e.g. which
# assignments count as future when a user is deactivated). Default Europe/Warsaw.
# BUSINESS_TIMEZONE=Europe/Warsaw
