# ── Shift Changer backend — environment template ───────────────────────────
# For running the backend WITHOUT Docker (php artisan serve, composer test): copy to backend/.env
# and run `php artisan key:generate`. The Docker stack does not read this file: docker-compose.yml
# passes its settings from the root .env (see the root .env.example).
# Only variables this app reads are listed; anything else falls back to Laravel's defaults.

APP_NAME="Shift Changer"
# local | testing | production. Outside local/testing the seeder needs SEED_ADMIN_PASSWORD.
APP_ENV=local
# Generated by `php artisan key:generate`. Required.
APP_KEY=
# Never true in production (stack traces and environment details in error pages).
APP_DEBUG=true
APP_URL=http://localhost:8000

# The organisation's local timezone: decides what "today" means for business rules (e.g. which
# assignments count as future when a user is deactivated).
BUSINESS_TIMEZONE=Europe/Warsaw

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# The tests use their own database, shift_changer_test (phpunit.xml); create it once (README).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shift_changer
DB_USERNAME=postgres
DB_PASSWORD=

# ── Sessions and SPA auth (Sanctum) ────────────────────────────────────────
# Hosts (host:port, comma-separated) whose requests get cookie-based SPA auth: the frontend's.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
# Session cookie domain; leave empty for the current host.
# SESSION_DOMAIN=
SESSION_DRIVER=file
# Minutes of inactivity before the session expires.
SESSION_LIFETIME=120
# true = session cookie over HTTPS only. Set it in production behind TLS; false for plain http.
SESSION_SECURE_COOKIE=false

# ── Rate limits and proxies ────────────────────────────────────────────────
# Max API requests per minute, per user (HTTP 429 beyond that). Default 60.
API_RATE_LIMIT=60
# Failed logins allowed per minute for one email from one client IP before a 429. Default 5.
LOGIN_RATE_LIMIT=5
# Comma-separated proxies (IPs/CIDRs) whose X-Forwarded-For/-Proto are believed. Empty = the
# private and loopback ranges (the frontend Nginx on the compose network). Never "*".
TRUSTED_PROXIES=

# ── Seeding ────────────────────────────────────────────────────────────────
# First admin password for `php artisan db:seed` (admin@shiftchanger.com). Required, at least 12
# characters, whenever APP_ENV is not local/testing: the seeder refuses to run without it. In
# local/testing it defaults to 1234 (the dev/e2e login); set it here to override that.
# SEED_ADMIN_PASSWORD=

# ── Logging, cache, queue ──────────────────────────────────────────────────
# stack writes storage/logs/laravel.log; the Docker stack uses stderr.
LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
