    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.11",
    "axios": "^1.13.5",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^2.1.0",
    "lint-staged": "^17.2.0",
    "lodash": "^4.17.19",
    "msw": "^2.15.0",
    "postcss": "^8.1.14",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.20.0",
