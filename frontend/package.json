{
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:hybrid": "vite --config vite.config.hybrid.js",
    "build": "vite build",
    "build:docker": "vite build --config vite.config.docker.js",
    "lint": "biome check --diagnostic-level=error .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "cd .. && husky frontend/.husky",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:all": "npm run test && npm run test:browser && npm run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test --config=playwright.unit.config.js"
  },
  "lint-staged": {
    "*.{js,vue}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "laravel-vite-plugin": "^2.1.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.1.14",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vitejs/plugin-vue": "^6.0.4",
    "axios": "^1.20.0",
    "diff": "^8.0.3",
    "dompurify": "^3.4.16",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.4"
  }
}
