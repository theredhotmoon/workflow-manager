{
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:hybrid": "vite --config vite.config.hybrid.js",
    "build": "vite build",
    "build:docker": "vite build --config vite.config.docker.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "cd .. && husky frontend/.husky",
    "test": "playwright test --config=playwright.unit.config.js",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{js,vue}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
